public function index()
    {
        if (!session()->has('page')) {
            session(['page' => 'login']);
        }

        return view('auth.login-register.index')->with([
            'title'             => 'Login',
            'login'             => $this->setActivePage('login'),
            'register'          => $this->setActivePage('register'),
        ]);
    }

    protected function setActivePage($page)
    {
        return [
            'active'    => Session::get('page') === $page ? 'active' : '',
            'selected'  => Session::get('page') === $page ? 'true' : 'false',
            'show'      => Session::get('page') === $page ? 'show active' : '',
        ];
    }


    public function SessionPageSwitch($page)
    {
        if ($page == 'login' || $page == 'register') {
            session(['page' => $page]);
            return redirect('/');
        } else {
            return abort(404);
        }
    }

